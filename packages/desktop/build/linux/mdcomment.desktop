[Desktop Entry]
Name=MDComment
Comment=Next generation markdown editor
Exec=mdcomment %F
Terminal=false
Type=Application
Icon=mdcomment
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=mdcomment;
StartupWMClass=mdcomment
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=mdcomment --new-window %F
Icon=mdcomment
